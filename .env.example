# HCAI-ITS Environment Variables
# Copy this file to backend/.env and fill in your values

# JWT Auth
SECRET_KEY=change-this-to-a-random-32-char-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Supabase (https://supabase.com/dashboard/project/_/settings/api)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_KEY=<your-anon-public-key>
# Required for the backend, not just seed scripts: the app tables should have
# RLS enabled with no anon-role policies, so the backend needs the
# service_role key to read/write them (it does its own auth checks already).
# Keep this out of the frontend/browser entirely.
SUPABASE_SERVICE_KEY=<your-service-role-key>

# Groq LLM (https://console.groq.com/keys)
GROQ_API_KEY=<your-groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# Email (optional — for OTP auth)
RESEND_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=HCAI Intelligent Tutor
